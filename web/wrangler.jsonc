{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "total-tossup-live-web",
  "compatibility_date": "2026-08-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "totaltossup.live", "custom_domain": true }
  ]
}
